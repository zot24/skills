# Varlock schema: https://varlock.dev
# Secrets come from the agents' 1Password vault. Keep the vault name out of this file:
# OP_VAULT is set in the environment (or in an uncommitted .env.local).
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN)
# @defaultSensitive=false
# ---

# @type=opServiceAccountToken @sensitive
OP_SERVICE_ACCOUNT_TOKEN=

# @required
OP_VAULT=

# Stripe: one account, products per brand. Test keys until launch.
# @sensitive
STRIPE_SECRET_KEY=op("op://${OP_VAULT}/stripe/credential")
# @sensitive
STRIPE_WEBHOOK_SECRET=op("op://${OP_VAULT}/stripe-webhook-example/credential")

# Resend. Setup runs use the account key; the site gets a sending-only key for its own domain
# (docs/email.md), pushed to the Worker as RESEND_API_KEY.
# @sensitive
RESEND_API_KEY=op("op://${OP_VAULT}/resend/credential")
# @sensitive
RESEND_SITE_KEY=op("op://${OP_VAULT}/resend-example/credential")

# Cloudflare (cloudflare-domains skill)
# @sensitive
CLOUDFLARE_API_TOKEN=op("op://${OP_VAULT}/cloudflare/credential")
CLOUDFLARE_ACCOUNT_ID=op("op://${OP_VAULT}/cloudflare/account_id")
